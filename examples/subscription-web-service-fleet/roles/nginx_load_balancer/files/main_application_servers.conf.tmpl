# Managed by MMX (role nginx_load_balancer): the main application's API and
# web pages.
#
# Maintenance pages: the playbook load_balancer_maintenance_pages links
# maintenance_on.html to maintenance.html in a server's web root. Each server
# tests for that file on every request, so a change needs no reload.
{{- $certificates := .inputs.tls_certificate_dir }}
{{- $certificate := .inputs.main_application_certificate_name }}

# Names nobody serves get 404.
server {
    listen 80 default_server;
    listen 443 ssl http2 default_server;
    server_name _;
    ssl_certificate     {{ $certificates }}/{{ $certificate }}/fullchain.pem;
    ssl_certificate_key {{ $certificates }}/{{ $certificate }}/privkey.pem;

    location / {
        return 404;
    }
}

server {
    listen 80;
    listen 443 ssl http2;
    server_name {{ .inputs.api_host_name }};
    ssl_certificate     {{ $certificates }}/{{ $certificate }}/fullchain.pem;
    ssl_certificate_key {{ $certificates }}/{{ $certificate }}/privkey.pem;
    include /etc/nginx/includes/proxy_headers.conf;

    if (-f /var/www/main_application_api/maintenance_on.html) {
        return 503;
    }
    error_page 503 @maintenance;
    location @maintenance {
        root /var/www/main_application_api;
        rewrite ^ /maintenance.html break;
    }

    location / {
        proxy_pass http://main_application_api;
    }
}

server {
    listen 80;
    listen 443 ssl http2;
    server_name {{ .inputs.main_application_host_name }};
    ssl_certificate     {{ $certificates }}/{{ $certificate }}/fullchain.pem;
    ssl_certificate_key {{ $certificates }}/{{ $certificate }}/privkey.pem;
    include /etc/nginx/includes/proxy_headers.conf;

    if (-f /var/www/main_application/maintenance_on.html) {
        return 503;
    }
    error_page 503 @maintenance;
    location @maintenance {
        root /var/www/main_application;
        rewrite ^ /maintenance.html break;
    }

    location / {
        proxy_pass http://main_application_web_pages;
    }

    # A few tries in a row, then a pause (nginx.conf).
    location /login {
        limit_req zone=login burst=6 nodelay;
        proxy_pass http://main_application_web_pages;
    }

    location /password_reset {
        limit_req zone=password_reset burst=2 nodelay;
        proxy_pass http://main_application_web_pages;
    }
}
