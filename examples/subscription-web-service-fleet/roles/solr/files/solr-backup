#!/bin/bash
# Managed by MMX (role solr). Runs as the account solr.
# Keeps the two most recent backups, then asks Solr for a new one in a
# directory named like snapshot.20261015021500123.
#
# Follow a backup:  curl "http://localhost:8983/solr/$SOLR_CORE/replication?command=details"
# Restore one:      curl "http://localhost:8983/solr/$SOLR_CORE/replication?command=restore&location=$SOLR_BACKUP_DIR"
set -euo pipefail

find "$SOLR_BACKUP_DIR" -mindepth 1 -maxdepth 1 -name 'snapshot.*' -printf '%T@ %p\n' \
  | sort -rn | tail -n +3 | cut -d' ' -f2- | xargs -r rm -rf

curl --silent --show-error --fail \
  "http://localhost:8983/solr/$SOLR_CORE/replication?command=backup&location=$SOLR_BACKUP_DIR"
