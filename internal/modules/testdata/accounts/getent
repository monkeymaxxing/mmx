#!/bin/sh
# A stand-in for getent over the account files in $MMX_FAKE_ACCOUNTS:
# getent [-s files] passwd|group|shadow NAME_OR_ID. Exit 2 means not found.
echo "getent $*" >> "$MMX_FAKE_ACCOUNTS/calls"
if [ "$1" = -s ]; then shift 2; fi
database=$1 key=$2
awk -F: -v key="$key" -v database="$database" '
  $1 == key || (database != "shadow" && $3 == key) { print; found = 1; exit }
  END { exit found ? 0 : 2 }' "$MMX_FAKE_ACCOUNTS/$database"
